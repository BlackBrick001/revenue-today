# Add these in Vercel > Project > Settings > Environment Variables
MEWS_ENV=demo                    # demo | production (demo uses Mews' public demo tokens)
SUPABASE_URL=                    # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # Supabase > Settings > API > service_role (keep secret)
APP_PASSWORD=                    # optional on demo, required before production
CRON_SECRET=                     # optional; any random text

# Production only
MEWS_CLIENT_TOKEN=
PROPERTIES=                      # [{"name":"Sandton 1","accessToken":"..."}, ...]
REVENUE_BASIS=net                # net | gross
